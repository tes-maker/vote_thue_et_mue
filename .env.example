# Modèle de configuration. Détail de chaque variable : README.md, section « Configuration ».

# `production` exige HTTPS : sinon le cookie de session est refusé et la connexion échoue.
# En local, en HTTP, utilisez `development`.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://vote_app:MOT_DE_PASSE_POSTGRES@127.0.0.1:5432/vote_app
# Au moins 32 caractères : openssl rand -hex 32
SESSION_SECRET=COLLER_ICI_UN_SECRET_GENERE_AVEC_OPENSSL
# Facultatif : jeton d'accès API serveur-à-serveur (au moins 32 caractères).
# Générez-le avec `openssl rand -hex 32` et gardez-le hors du navigateur.
# API_BEARER_TOKEN=
# Mettez 1 uniquement si l'application est derrière un reverse proxy de confiance.
TRUST_PROXY=0
