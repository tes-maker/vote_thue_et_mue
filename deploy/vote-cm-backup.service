[Unit]
Description=Sauvegarde PostgreSQL du registre des votes
After=postgresql.service

[Service]
Type=oneshot
User=vote-cm
Group=vote-cm
WorkingDirectory=/opt/vote_thue_et_mue
EnvironmentFile=/etc/vote-cm/backup.env
ExecStart=/bin/sh /opt/vote_thue_et_mue/scripts/backup-postgres.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/vote-cm
